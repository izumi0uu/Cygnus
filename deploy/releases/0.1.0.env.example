# =============================================================================
# Cygnus PRODUCTION release metadata (CYG-128)
#
# One file per deployable release: deploy/releases/<CYGNUS_RELEASE>.env
# (the directory is git-ignored except for *.env.example files).
#
# Generate it from the release supply chain's manifest
# (production/image-manifest.json, schema_version 1):
#
#   scripts/prod/write-release-env.py 0.1.0 \
#     --repository ghcr.io/<owner>/Cygnus
#
# or copy this example and replace the digests manually. The mapping is:
#   images.backend.digest   -> CYGNUS_API_IMAGE    = <repository>/backend@sha256:<digest>
#   images.frontend.digest  -> CYGNUS_FRONTEND_IMAGE = <repository>/frontend@sha256:<digest>
#
# deploy.sh refuses to run without this file and refuses non-digest-pinned
# image refs - the compose manifest fails interpolation if these variables
# are absent, so production cannot start without them.
# =============================================================================

CYGNUS_API_IMAGE=ghcr.io/OWNER/Cygnus/backend@sha256:REPLACE_WITH_DIGEST
CYGNUS_FRONTEND_IMAGE=ghcr.io/OWNER/Cygnus/frontend@sha256:REPLACE_WITH_DIGEST
