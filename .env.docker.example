# Cygnus backend runtime — Docker compose local stack overrides.
#
# This file documents the exact runtime keys used by the current backend.
# The compose file already ships with the same defaults inline, so copying this
# file is optional unless you want to override the local stack.

# --- Database ---
database_url=postgresql+asyncpg://cygnus:cygnus_secret@postgres:5432/cygnus

# --- Auth / bootstrap ---
secret_key=cygnus-local-dev-secret-key
default_admin_email=admin@cygnus.local
default_admin_password=admin123
mcp_token_pepper=cygnus-local-dev-pepper

# --- Runtime environment (fail-closed gate) ---
# local | test | production. Outside local/test the runtime REFUSES to start
# while any default secret/credential above (or CORS_ORIGINS=*) is set —
# production deployments must set real secrets explicitly.
environment=local

# --- Login abuse budget (shared Redis, applies to /api/auth/login and
#     the OAuth authorize form) ---
login_rate_limit_attempts=5
login_rate_limit_window_seconds=300

# --- Reverse proxy trust (forwarded headers) ---
# Comma-separated IPs/CIDRs whose X-Forwarded-For header is trusted when
# resolving the client IP for abuse budgets. Forwarded headers from any
# other peer are ignored. The docker-compose nginx gateway lives on the
# default compose network (172.16.0.0/12) — its appended X-Forwarded-For
# is what lets rate limiting see the real browser IP.
trusted_proxy_ips=127.0.0.1,::1,172.16.0.0/12

# --- MinIO ---
minio_endpoint=minio:9000
minio_public_endpoint=localhost:9000
minio_access_key=minioadmin
minio_secret_key=minioadmin123
minio_bucket=cygnus-files
minio_secure=false
minio_presign_expiry_hours=24

# --- Frontend / portal ---
cors_origins=http://localhost:5173,http://127.0.0.1:5173
portal_base_url=http://localhost:5173

# --- Redis / worker queue ---
redis_host=redis
redis_port=6379
# The compose Redis service enforces a password (see docker-compose.yml
# CYGNUS_DOCKER_REDIS_PASSWORD, default cygnus_redis_secret). Keep this in sync.
redis_password=cygnus_redis_secret
redis_db=0
worker_max_jobs=3
worker_job_timeout=1800

# --- Runtime health / worker heartbeat ---
health_probe_timeout_seconds=5.0
worker_heartbeat_interval_seconds=10
worker_heartbeat_timeout_seconds=30
# SIGTERM drain grace; keep the worker services' stop_grace_period above this.
worker_drain_grace_seconds=30

# --- MRP defaults ---
mrp_auto_approve_plan=false
mrp_multipass_writer_enabled=true
auto_approve_extraction_threshold_tokens=200000
extraction_approval_ttl_hours=24
max_auto_recover_attempts=3

# --- Propagation delivery (CYG-138 internal-channel adapter) ---
delivery_targets_json={}
delivery_hmac_secret=
delivery_timeout_seconds=10
delivery_max_attempts=5

# --- Observability / telemetry (CYG-142) ---
# Master switches for the bounded observability surface.
telemetry_enabled=true
prometheus_metrics_enabled=true
# Optional OTLP/HTTP span export endpoint. Empty = in-process spans only.
otlp_endpoint=
otlp_service_name=cygnus
# Cardinality bounds for metric/span label values and per-metric series.
telemetry_max_label_length=64
telemetry_max_series_per_metric=200
# Runtime release identity (build-time labels; values are sanitized at read).
# APP_RELEASE=v1.0.0
# APP_COMMIT_SHA=0123456789abcdef0123456789abcdef01234567
# APP_IMAGE_REF=cygnus-api@sha256:abcdef...
# APP_ENVIRONMENT=local
# APP_DEPLOYMENT_ID=local-stack
# EXPECTED_ALEMBIC_HEAD=20260812_08
