# Cygnus production reverse proxy (CYG-128).
#
# This file is mounted at /etc/nginx/templates/default.conf.template and
# rendered to /etc/nginx/conf.d/default.conf by the official nginx image
# entrypoint (envsubst). Only environment variables set on the container
# (CYGNUS_DOMAIN, CYGNUS_PUBLIC_ORIGIN, MINIO_BUCKET) are substituted; nginx
# runtime variables ($host, $uri, ...) are preserved as-is.
#
# TLS material is provided as Docker secrets mounted at /run/secrets/.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Container HTTP on unprivileged :8080 redirects to the public HTTPS origin.
server {
    listen 8080;
    server_name ${CYGNUS_DOMAIN};

    location / {
        return 301 ${CYGNUS_PUBLIC_ORIGIN}$request_uri;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${CYGNUS_DOMAIN};

    ssl_certificate     /run/secrets/cygnus_tls_cert;
    ssl_certificate_key /run/secrets/cygnus_tls_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 50m;

    include /etc/nginx/security-headers.conf;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # Liveness reaches only the API process. Readiness additionally gates the
    # API report on the delivery consumer's signing + durable-store health.
    location = /health {
        proxy_pass http://api:8077/health;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/security-headers.conf;
    }

    location = /livez {
        proxy_pass http://api:8077/livez;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/security-headers.conf;
    }

    location = /_delivery-consumer-health {
        internal;
        proxy_pass http://delivery-consumer:8090/health;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_connect_timeout 1s;
        proxy_read_timeout 2s;
        proxy_send_timeout 2s;
    }

    location = /_delivery-consumer-not-ready {
        internal;
        default_type application/json;
        return 503 '{"status":"not_ready","checks":{"delivery_consumer":{"status":"failed"}}}';
    }

    location = /readyz {
        auth_request /_delivery-consumer-health;
        error_page 500 =503 /_delivery-consumer-not-ready;
        proxy_pass http://api:8077/readyz;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/security-headers.conf;
    }

    # Metrics are an explicitly allowlisted internal scrape surface. The
    # value is a required operator input; never replace it with 0.0.0.0/0.
    location = /metrics {
        allow ${CYGNUS_METRICS_ALLOWED_CIDR};
        deny all;
        proxy_pass http://api:8077/metrics;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/security-headers.conf;
    }


    location = /docs {
        proxy_pass http://api:8077/docs;
    }

    location = /redoc {
        proxy_pass http://api:8077/redoc;
    }

    location = /openapi.json {
        proxy_pass http://api:8077/openapi.json;
    }

    # Signed propagation receipts are handled only by the bounded delivery
    # consumer. This exact route stays ahead of the generic API proxy; normal
    # proxy behavior preserves the delivery, correlation, and ack headers.
    location = /api/internal/propagation-delivery {
        client_max_body_size 1m;
        proxy_pass http://delivery-consumer:8090;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/security-headers.conf;
    }

    location ^~ /api/ {
        proxy_pass http://api:8077;
    }

    location = /api {
        proxy_pass http://api:8077;
    }

    location ^~ /oauth/ {
        proxy_pass http://api:8077;
    }

    location = /oauth {
        proxy_pass http://api:8077;
    }

    # MCP streaming - no buffering, long timeouts.
    location ^~ /mcp/ {
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://api:8077;
    }

    location = /mcp {
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://api:8077;
    }

    location ^~ /.well-known/ {
        proxy_pass http://api:8077;
    }

    # Presigned MinIO downloads are path-style through the proxy. Requires
    # MINIO_PUBLIC_ENDPOINT=<same host as CYGNUS_DOMAIN> (no scheme, no path)
    # so presigned URLs stay same-origin: https://<domain>/<bucket>/<key>.
    location ^~ /${MINIO_BUCKET}/ {
        proxy_pass http://minio:9000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Vite hashed build assets - immutable cache.
    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    # Static fonts.
    location ~* \.(?:woff2?|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    # index.html must never be cached (SPA shell).
    location = /index.html {
        add_header Cache-Control "no-store";
        include /etc/nginx/security-headers.conf;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
