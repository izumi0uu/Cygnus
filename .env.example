# Cygnus backend runtime — host-local development environment.
#
# Copy to `.env` and edit:
#   cp .env.example .env
#
# IMPORTANT:
# - Settings are loaded by `cygnus/runtime/config.py`
# - there is NO `CYGNUS_` env prefix in the current runtime
# - Docker compose injects its own container hostnames; this file is for
#   host-local runs like `uvicorn cygnus.runtime.main:app --reload`

# --- Database ---
database_url=postgresql+asyncpg://cygnus:cygnus_secret@localhost:5432/cygnus

# --- Auth / bootstrap ---
secret_key=change-me-to-a-random-secret-string
default_admin_email=admin@cygnus.local
default_admin_password=admin123
mcp_token_pepper=change-me-to-a-random-pepper

# --- Runtime environment (fail-closed gate) ---
# local | test | production. Outside local/test the runtime REFUSES to start
# while any default secret/credential above (or CORS_ORIGINS=*) is set —
# production deployments must set real secrets explicitly.
environment=local

# --- Login abuse budget (shared Redis, applies to /api/auth/login and
#     the OAuth authorize form) ---
login_rate_limit_attempts=5
login_rate_limit_window_seconds=300

# --- Reverse proxy trust (forwarded headers) ---
# Comma-separated IPs/CIDRs whose X-Forwarded-For header is trusted when
# resolving the client IP for abuse budgets. Forwarded headers from any
# other peer are ignored. Behind the docker-compose nginx gateway include
# your docker network CIDR (e.g. 172.16.0.0/12).
trusted_proxy_ips=127.0.0.1,::1

# --- MinIO ---
minio_endpoint=localhost:9000
minio_public_endpoint=localhost:9000
minio_access_key=minioadmin
minio_secret_key=minioadmin123
minio_bucket=cygnus-files
minio_secure=false
minio_presign_expiry_hours=24

# --- Frontend / portal ---
cors_origins=http://localhost:5173,http://127.0.0.1:5173
portal_base_url=http://localhost:5173

# --- Redis / worker queue ---
# The local docker stack (docker-compose.yml) enforces a password
# (CYGNUS_DOCKER_REDIS_PASSWORD, default cygnus_redis_secret). For host-local
# runs, configure the same password on your redis-server.
redis_host=localhost
redis_port=6379
redis_password=cygnus_redis_secret
redis_db=0
worker_max_jobs=3
worker_job_timeout=1800

# --- Runtime health / worker heartbeat ---
# livez is side-effect-free; readyz probes dependencies under this timeout.
health_probe_timeout_seconds=5.0
# Worker heartbeat refresh cadence; staleness beyond
# worker_heartbeat_timeout_seconds fails readyz (must exceed the interval).
worker_heartbeat_interval_seconds=10
worker_heartbeat_timeout_seconds=30
# SIGTERM drain grace: stop claiming jobs, wait this long for in-flight work.
# Keep docker-compose stop_grace_period for workers above this value.
worker_drain_grace_seconds=30

# --- MRP defaults ---
mrp_auto_approve_plan=false
mrp_multipass_writer_enabled=true
auto_approve_extraction_threshold_tokens=200000
extraction_approval_ttl_hours=24
max_auto_recover_attempts=3

# --- Observability / telemetry (CYG-142) ---
telemetry_enabled=true
prometheus_metrics_enabled=true
otlp_endpoint=
otlp_service_name=cygnus
telemetry_max_label_length=64
telemetry_max_series_per_metric=200
# Runtime release identity (sanitized at read; see cygnus/observability/_identity.py).
# APP_RELEASE=v0.1.0-local
# APP_COMMIT_SHA=dev
# APP_IMAGE_REF=local
# APP_ENVIRONMENT=local
# APP_DEPLOYMENT_ID=local
# EXPECTED_ALEMBIC_HEAD=20260812_08

# --- Propagation delivery (CYG-138 internal-channel adapter) ---
# JSON map of propagation surface id -> allowed internal delivery base URL.
# Only surfaces listed here receive outbound delivery attempts; every hop
# (including redirects) must stay inside the configured origins.
delivery_targets_json={}
# HMAC-SHA256 secret shared with internal delivery targets. Signs outbound
# delivery bodies and verifies signed acknowledgements. Never log this value.
delivery_hmac_secret=
# Outbound delivery HTTP timeout in seconds (bounded retries).
delivery_timeout_seconds=10
# Maximum bounded delivery attempts before dead-lettering.
delivery_max_attempts=5
