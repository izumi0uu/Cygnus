# =============================================================================
# Cygnus PRODUCTION environment (CYG-128)
#
# Copy to deploy/.env.prod (git-ignored) and fill every value:
#   cp deploy/.env.prod.example deploy/.env.prod && $EDITOR deploy/.env.prod
#
# deploy.sh / rollback.sh refuse to run with missing or placeholder values,
# and docker compose fails fast if this file is absent (env_file required).
#
# Rules:
#   - plain KEY=value lines only (no `export`, no shell syntax, no quoting)
#   - uppercase names are used here; the runtime settings loader
#     (cygnus/runtime/config.py) matches environment names case-insensitively
#   - values shared between services (e.g. REDIS_PASSWORD and the app's
#     redis_password) are the same key thanks to case-insensitive matching;
#     where the app key differs from the infra key (DATABASE_URL vs
#     POSTGRES_PASSWORD, MINIO_SECRET_KEY vs MINIO_ROOT_PASSWORD) the example
#     notes that they must hold the same value
# =============================================================================

# Runtime security gate; production must never inherit the local default.
ENVIRONMENT=production

# --- Protected operator state -------------------------------------------------
# CI/operator entrypoints set this variable before invoking scripts/prod/*.sh.
# Keeping the same value here makes child commands and Compose resolve the same
# protected file rather than a transient Actions checkout.
CYGNUS_PRODUCTION_ENV_FILE=/etc/cygnus/releases/environment.env
# Successful deployments atomically persist immutable release metadata and the
# active/previous pointer outside the checkout so rollback survives runner cleanup.
CYGNUS_RELEASES_DIR=/var/lib/cygnus/releases
CYGNUS_DEPLOY_STATE_FILE=/var/lib/cygnus/deploy-state.env
# Each certified source archive is installed at CYGNUS_CHECKOUTS_DIR/<release>.
# Deploy and rollback execute from that immutable tree; the stable link moves
# only after the candidate passes the public ingress gate.
CYGNUS_CHECKOUTS_DIR=/var/lib/cygnus/checkouts
CYGNUS_ACTIVE_CHECKOUT_LINK=/srv/cygnus/current
# Generated validation evidence and rendered operator files never modify the
# immutable release source tree.
CYGNUS_OPERATOR_WORK_DIR=/var/lib/cygnus/operator-work

# --- Public ingress -----------------------------------------------------------
# Required public DNS name; the production-input gate rejects this template.
CYGNUS_DOMAIN=REPLACE_WITH_PUBLIC_FQDN

# --- TLS certificates (external secret refs - never committed) ----------------
# Host paths to the certificate chain and private key. deploy.sh verifies both.
CYGNUS_TLS_CERT_FILE=/REPLACE_WITH_TLS_CERTIFICATE_PATH
CYGNUS_TLS_KEY_FILE=/REPLACE_WITH_TLS_PRIVATE_KEY_PATH

# Proxy trust is deliberately narrow: Docker's deterministic prodnet CIDR.
# Do not use 0.0.0.0/0 or the local defaults. Changing this requires changing
# deploy/docker-compose.prod.yml and the approved production-input manifest.
TRUSTED_PROXY_IPS=172.30.0.0/24

# Metrics are proxied only for this separately approved scrape CIDR.
CYGNUS_METRICS_ALLOWED_CIDR=CHANGE_ME
# Approved identity for the narrow metrics CIDR. It must match the production
# input manifest; the CIDR itself is checked as safe nginx syntax at deploy.
CYGNUS_METRICS_ALLOWLIST_REF=network-policy://REPLACE_WITH_METRICS_ALLOWLIST

# Capacity gate identity is external and immutable. These exact paths/ref/hash
# are revalidated against the approved manifest before deployment/certification.
CYGNUS_CAPACITY_THRESHOLDS_FILE=/REPLACE_WITH_APPROVED_CAPACITY_THRESHOLDS_JSON
CYGNUS_CAPACITY_TARGETS_FILE=/REPLACE_WITH_APPROVED_CAPACITY_TARGETS_JSON
CYGNUS_CAPACITY_APPROVAL_REF=approval://REPLACE_WITH_CAPACITY_APPROVAL
CYGNUS_CAPACITY_THRESHOLDS_REF=capacity-config://REPLACE_WITH_APPROVED_THRESHOLDS
CYGNUS_CAPACITY_TARGETS_REF=capacity-config://REPLACE_WITH_APPROVED_TARGETS
CYGNUS_CAPACITY_THRESHOLDS_SHA256=sha256:REPLACE_WITH_64_HEX_THRESHOLD_FILE_HASH

# Prometheus rule limits are rendered only from this approved external JSON.
CYGNUS_ALERT_THRESHOLDS_FILE=/REPLACE_WITH_APPROVED_ALERT_THRESHOLDS_JSON
CYGNUS_ALERT_APPROVAL_REF=approval://REPLACE_WITH_ALERT_THRESHOLD_APPROVAL
CYGNUS_ALERT_THRESHOLDS_REF=observability-config://REPLACE_WITH_APPROVED_ALERT_THRESHOLDS
CYGNUS_ALERT_THRESHOLDS_SHA256=sha256:REPLACE_WITH_64_HEX_ALERT_THRESHOLD_FILE_HASH

# Backup/drill identity and recovery approvals. The production-input manifest
# must contain these exact non-secret identifiers; real backup credentials and
# key files are supplied only to the protected certification runner.
CYGNUS_BACKUP_SOURCE_ID=production://REPLACE_WITH_BACKUP_SOURCE_ID
CYGNUS_RPO_OBJECTIVE_REF=approval://REPLACE_WITH_RPO_OBJECTIVE
CYGNUS_RTO_OBJECTIVE_REF=approval://REPLACE_WITH_RTO_OBJECTIVE

# --- Protected backup/restore drill runner (required for certification) ------
# These are host-provided secrets, paths, and isolated-target coordinates. They
# are not consumed by the normal application containers. The scheduled/manual
# drill and release certification fail closed until every value is supplied.
CYGNUS_BACKUP_OUTPUT_BASE=/REPLACE_WITH_PROTECTED_BACKUP_DIRECTORY
CYGNUS_BACKUP_AGE_RECIPIENT=REPLACE_WITH_AGE_RECIPIENT
CYGNUS_BACKUP_AGE_IDENTITY_FILE=/REPLACE_WITH_AGE_IDENTITY_FILE
CYGNUS_BACKUP_SIGNING_KEY_FILE=/REPLACE_WITH_BACKUP_SIGNING_PRIVATE_KEY
CYGNUS_BACKUP_SIGNING_PUBLIC_KEY_FILE=/REPLACE_WITH_BACKUP_SIGNING_PUBLIC_KEY
CYGNUS_BACKUP_KEY_MATERIAL_FILE=/REPLACE_WITH_RUNTIME_KEY_MATERIAL_JSON
CYGNUS_BACKUP_DATABASE_URL=postgresql+asyncpg://REPLACE_WITH_BACKUP_DATABASE_URL
CYGNUS_BACKUP_MINIO_ENDPOINT=REPLACE_WITH_BACKUP_MINIO_ENDPOINT
CYGNUS_BACKUP_MINIO_ACCESS_KEY=CHANGE_ME
CYGNUS_BACKUP_MINIO_SECRET_KEY=CHANGE_ME
CYGNUS_BACKUP_MINIO_BUCKET=REPLACE_WITH_BACKUP_MINIO_BUCKET
CYGNUS_BACKUP_MINIO_SECURE=true
CYGNUS_DRILL_COMPOSE_FILE=/REPLACE_WITH_ISOLATED_DRILL_COMPOSE_FILE
CYGNUS_DRILL_COMPOSE_ENV_FILE=/REPLACE_WITH_ISOLATED_DRILL_ENV_FILE
CYGNUS_DRILL_COMPOSE_PROJECT_DIRECTORY=/REPLACE_WITH_ISOLATED_DRILL_PROJECT_DIRECTORY
CYGNUS_DRILL_POSTGRES_USER=REPLACE_WITH_DRILL_POSTGRES_USER
CYGNUS_DRILL_POSTGRES_DB=REPLACE_WITH_NEW_DRILL_DATABASE
CYGNUS_DRILL_DATABASE_URL=postgresql+asyncpg://REPLACE_WITH_DRILL_DATABASE_URL
CYGNUS_DRILL_REDIS_URL=redis://:CHANGE_ME@REPLACE_WITH_DRILL_REDIS_HOST:6379/14
CYGNUS_DRILL_MINIO_ENDPOINT=REPLACE_WITH_DRILL_MINIO_ENDPOINT
CYGNUS_DRILL_MINIO_ACCESS_KEY=CHANGE_ME
CYGNUS_DRILL_MINIO_SECRET_KEY=CHANGE_ME
CYGNUS_DRILL_MINIO_BUCKET=REPLACE_WITH_NEW_DRILL_MINIO_BUCKET
CYGNUS_DRILL_MINIO_SECURE=false
CYGNUS_DRILL_ID=REPLACE_WITH_NEW_ISOLATED_DRILL_ID
CYGNUS_APPROVED_RPO_SECONDS=CHANGE_ME
CYGNUS_APPROVED_RTO_SECONDS=CHANGE_ME

# --- Approved secret rotation and incident containment -----------------------
# The executables live on the protected operations runner. They receive only
# identifiers/paths; neither command accepts secret values on argv.
CYGNUS_SECRET_ROTATION_RUNNER=/REPLACE_WITH_SECRET_ROTATION_RUNNER
CYGNUS_SECRET_ROTATION_APPROVAL_REF=approval://REPLACE_WITH_SECRET_ROTATION_APPROVAL
CYGNUS_INCIDENT_CONTAINMENT_RUNNER=/REPLACE_WITH_INCIDENT_CONTAINMENT_RUNNER
CYGNUS_INCIDENT_APPROVAL_REF=approval://REPLACE_WITH_INCIDENT_APPROVAL

# --- Postgres ----------------------------------------------------------------
POSTGRES_DB=cygnus
POSTGRES_USER=cygnus
POSTGRES_PASSWORD=CHANGE_ME
# App connection URL - credentials MUST match POSTGRES_* above. URL-encode any
# special characters in the password (e.g. %40 for @).
DATABASE_URL=postgresql+asyncpg://cygnus:CHANGE_ME@postgres:5432/cygnus

# --- Redis -------------------------------------------------------------------
# One key feeds both the redis server (--requirepass) and the app's
# redis_password setting (case-insensitive match).
REDIS_PASSWORD=CHANGE_ME
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- MinIO -------------------------------------------------------------------
# Server root credentials (minio server container).
MINIO_ROOT_USER=cygnus
MINIO_ROOT_PASSWORD=CHANGE_ME
# App credentials - set to the same values as MINIO_ROOT_* above.
MINIO_ACCESS_KEY=cygnus
MINIO_SECRET_KEY=CHANGE_ME
MINIO_ENDPOINT=minio:9000
# Browser-accessible host used in presigned URLs. It MUST equal CYGNUS_DOMAIN
# (no scheme/path) so all browser requests stay same-origin through nginx.
MINIO_PUBLIC_ENDPOINT=REPLACE_WITH_PUBLIC_FQDN
MINIO_BUCKET=cygnus-files
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRY_HOURS=24

# --- Application secrets (REQUIRED - no defaults in production) --------------
SECRET_KEY=CHANGE_ME
DEFAULT_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
DEFAULT_ADMIN_PASSWORD=CHANGE_ME
MCP_TOKEN_PEPPER=CHANGE_ME

# --- Governed internal delivery (CYG-138) -----------------------------------
# These targets are non-secret but must exactly match the approved
# production-input manifest. Only exact hosts listed below are permitted.
DELIVERY_TARGETS_JSON={"REPLACE_WITH_CHANNEL_ID":"https://REPLACE_WITH_INTERNAL_DELIVERY_HOST/v1/delivery"}
CYGNUS_DELIVERY_ALLOWED_HOSTS=REPLACE_WITH_INTERNAL_DELIVERY_HOST
# The value is injected by the external secret store. The reference identifies
# that binding for deploy/release validation and never contains the secret.
DELIVERY_HMAC_SECRET=CHANGE_ME
CYGNUS_DELIVERY_HMAC_SECRET_REF=secret-store://REPLACE_WITH_DELIVERY_HMAC_SECRET_REF

# --- Application settings -----------------------------------------------------
CORS_ORIGINS=https://REPLACE_WITH_PUBLIC_FQDN
PORTAL_BASE_URL=https://REPLACE_WITH_PUBLIC_FQDN

# Optional runtime identity override. When unset, deploy.sh generates a
# per-deploy APP_DEPLOYMENT_ID; APP_RELEASE/APP_COMMIT_SHA/EXPECTED_ALEMBIC_HEAD
# come from the release metadata (deploy/releases/<version>.env).
# APP_DEPLOYMENT_ID=20260812T120000Z

# --- Runtime tuning (optional; defaults match the runtime) --------------------
WORKER_MAX_JOBS=3
WORKER_JOB_TIMEOUT=1800
WORKER_DRAIN_GRACE_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_TIMEOUT_SECONDS=30
HEALTH_PROBE_TIMEOUT_SECONDS=5

# --- Required host sizing inputs ---------------------------------------------
# Values are deliberately not guessed. Set Compose-compatible CPU/memory limits
# after the approved capacity plan; deploy.sh rejects blank/placeholder values.
CYGNUS_APP_CPU_LIMIT=CHANGE_ME
CYGNUS_APP_MEMORY_LIMIT=CHANGE_ME
CYGNUS_POSTGRES_CPU_LIMIT=CHANGE_ME
CYGNUS_POSTGRES_MEMORY_LIMIT=CHANGE_ME
CYGNUS_REDIS_CPU_LIMIT=CHANGE_ME
CYGNUS_REDIS_MEMORY_LIMIT=CHANGE_ME
CYGNUS_MINIO_CPU_LIMIT=CHANGE_ME
CYGNUS_MINIO_MEMORY_LIMIT=CHANGE_ME
CYGNUS_FRONTEND_CPU_LIMIT=CHANGE_ME
CYGNUS_FRONTEND_MEMORY_LIMIT=CHANGE_ME
